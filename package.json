{
  "name": "opencode-sentry-monitor",
  "version": "0.2.0",
  "description": "Sentry AI Monitoring plugin for OpenCode v2 agent runs, model requests, and tool calls",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test",
    "prepack": "npm run build"
  },
  "keywords": [
    "opencode",
    "plugin",
    "sentry",
    "observability",
    "ai-monitoring"
  ],
  "author": "Scott Tolinski",
  "homepage": "https://tolin.ski",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thelooter/opencode-sentry-monitor.git"
  },
  "bugs": {
    "url": "https://github.com/thelooter/opencode-sentry-monitor/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@sentry/node": "^10.23.0",
    "strip-json-comments": "^5.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@opencode/plugin": "^2.0.23",
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2",
    "vitest": "^5.0.3"
  }
}
